# ==============================================================================
# Wasl AI - Production Environment Configuration Template (.env)
# ==============================================================================
# Copy this file to .env and replace placeholders with secure, real values.
# NEVER commit the actual .env file or real secrets to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
PROJECT_NAME="Wasl AI"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
API_V1_STR=/api/v1
ENABLE_API_DOCS=false

# Allowed Host headers (comma-separated or JSON list). Do NOT use '*' in production.
ALLOWED_HOSTS=["waslai.com","api.waslai.com","localhost"]

# ------------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECRETS (JWT)
# ------------------------------------------------------------------------------
# Mandatory in production. Must be at least 32 characters long with high entropy.
# Generate via: openssl rand -hex 32
SECRET_KEY=replace_with_a_cryptographically_secure_random_hex_32_bytes

# JWT Access Token lifetime in minutes (e.g. 10080 = 7 days, 11520 = 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256

# Cookie Security
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ------------------------------------------------------------------------------
# 3. POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_USER=wasl_admin
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=wasl_ai_prod

# Full connection string for SQLAlchemy
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Explicit list of permitted origins. NEVER use wildcard '*' in production.
BACKEND_CORS_ORIGINS=["https://waslai.com","https://app.waslai.com"]

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=replace_with_google_ai_studio_api_key
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. DOMAIN & REVERSE PROXY / TLS
# ------------------------------------------------------------------------------
DOMAIN_NAME=waslai.com
LETSENCRYPT_EMAIL=admin@waslai.com
SSL_CERT_PATH=/etc/nginx/ssl/live/fullchain.pem
SSL_KEY_PATH=/etc/nginx/ssl/live/privkey.pem
