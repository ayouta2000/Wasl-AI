# ==============================================================================
# Wasl AI - Production Environment Variables Example (.env.production.example)
# ==============================================================================
# Use these environment variables when configuring Render and Supabase.
# NEVER place actual passwords or secret keys in this file or commit them.

# --- Application Runtime ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="Wasl AI"
API_V1_STR=/api/v1
LOG_LEVEL=INFO
ENABLE_API_DOCS=false

# --- Security & JWT Authentication ---
# Generate a secure 32+ character random hex string: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_32_CHAR_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM=HS256
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Supabase PostgreSQL Database ---
# Replace [PASSWORD], [PROJECT_REF], and [REGION] with your Supabase credentials:
# Example: postgresql+psycopg2://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg2://postgres.your_supabase_ref:your_supabase_password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Optional Connection Pool Tuning for Free Tier
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Google Gemini AI ---
# Get your free API key at https://aistudio.google.com/
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# --- CORS & Hosts ---
# Explicit production frontend origin (URL of your Render Static Site)
CORS_ALLOWED_ORIGINS=https://wasl-ai-frontend.onrender.com
ALLOWED_HOSTS=*

# --- Frontend Build (Vite) ---
# Used by Render Static Site build to communicate with Render Web Service:
VITE_API_URL=https://wasl-ai-backend.onrender.com
